#!/usr/bin/python3
"""Mantiene la pantalla y el equipo despiertos mientras OpenCode está abierto.

Detecta procesos interactivos de OpenCode (con TTY, no el servicio `serve`).
Mientras exista uno:
  - registra un inhibidor logind idle+sleep (evita apagado/bloqueo por inactividad)
  - pide a org.freedesktop.ScreenSaver que no bloquee la pantalla
Al cerrar OpenCode libera ambos.
"""

from __future__ import annotations

import os
import signal
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

SERVICE_NAME = "OpenCode activo"
POLL_SECONDS = 3


def interactive_opencode_pids() -> list[int]:
    try:
        output = subprocess.check_output(
            ["ps", "-eo", "pid=,tty=,args="], text=True, timeout=5
        )
    except (OSError, subprocess.SubprocessError):
        return []

    pids: list[int] = []
    for line in output.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) < 3:
            continue
        pid, tty, args = parts
        if tty in {"?", "??"}:
            continue
        argv = args.split()
        if not argv or os.path.basename(argv[0]) != "opencode":
            continue
        try:
            pids.append(int(pid))
        except ValueError:
            continue
    return pids


class Awake:
    def __init__(self) -> None:
        self.child: subprocess.Popen[bytes] | None = None
        self.bus = None
        self.cookie: int | None = None

    def start(self) -> None:
        try:
            self.child = subprocess.Popen(
                [
                    "systemd-inhibit",
                    "--what=idle:sleep",
                    "--why=OpenCode está trabajando",
                    "--mode=block",
                    "sleep",
                    "infinity",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError as error:
            print(f"opencode-awake: no se pudo iniciar systemd-inhibit: {error}", file=sys.stderr)
            self.child = None

        try:
            if self.bus is None:
                self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            reply = self.bus.call_sync(
                "org.freedesktop.ScreenSaver",
                "/ScreenSaver",
                "org.freedesktop.ScreenSaver",
                "Inhibit",
                GLib.Variant("(ss)", ("opencode-awake", SERVICE_NAME)),
                None,
                Gio.DBusCallFlags.NONE,
                -1,
                None,
            )
            self.cookie = int(reply.unpack()[0])
        except Exception as error:  # noqa: BLE001 - best effort
            print(f"opencode-awake: sin inhibidor de pantalla: {error}", file=sys.stderr)
            self.cookie = None

        print(f"opencode-awake: activado (pids {interactive_opencode_pids()})", file=sys.stderr)

    def stop(self) -> None:
        if self.cookie is not None and self.bus is not None:
            try:
                self.bus.call_sync(
                    "org.freedesktop.ScreenSaver",
                    "/ScreenSaver",
                    "org.freedesktop.ScreenSaver",
                    "UnInhibit",
                    GLib.Variant("(u)", (self.cookie,)),
                    None,
                    Gio.DBusCallFlags.NONE,
                    -1,
                    None,
                )
            except Exception:  # noqa: BLE001
                pass
            self.cookie = None
        if self.child is not None:
            self.child.terminate()
            try:
                self.child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.child.kill()
            self.child = None
        print("opencode-awake: desactivado", file=sys.stderr)


def main() -> int:
    if "--status" in sys.argv:
        pids = interactive_opencode_pids()
        print("activo" if pids else "inactivo", pids)
        return 0

    running = True

    def stop(*_: object) -> None:
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    awake = Awake()
    active = False
    try:
        while running:
            found = bool(interactive_opencode_pids())
            if found and not active:
                awake.start()
            elif not found and active:
                awake.stop()
            active = found
            deadline = time.monotonic() + POLL_SECONDS
            while running and time.monotonic() < deadline:
                time.sleep(0.25)
    finally:
        awake.stop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
